model RentalOrder {
    id          String       @id @default(uuid())
    rentalDate  DateTime
    returnDate  DateTime?
    totalAmount Float
    status      RentalStatus @default(PLACED)

    customerId  String
    customer    User         @relation(fields: [customerId], references: [id])
    gearItemId  String
    gearItem    GearItem     @relation(fields: [gearItemId], references: [id])

    review      Review?      

    @@index([customerId])
    @@index([gearItemId])

    @@map("rental_orders")
}